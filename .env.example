# Server port
PORT=4000

# Absolute path where downloaded files are temporarily stored
DOWNLOAD_DIR=/tmp/bagback-downloads

# Absolute path to the compiled frontend static files (served by Express)
STATIC_DIR=/app/static

# Allowed CORS origin for the API — use '*' for open access or your domain
CORS_ORIGIN=https://download.bagbacktech.com

# Optional Google Cloud Storage bucket for durable job state & large-file Signed URL downloads
GCS_BUCKET=bagback-download-media-prod

# ─── Optional Frontend Analytics, Search Console & Display Ads ────────────────
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# VITE_GA_MEASUREMENT_ID=

# Google Search Console HTML verification token
# VITE_GOOGLE_SITE_VERIFICATION=

# Polite Display Ads & Fast Monetization ('none' | 'adsense' | 'custom' | 'sponsor')
VITE_AD_PROVIDER=none
# VITE_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# VITE_ADSENSE_SLOT_TOP=
# VITE_ADSENSE_SLOT_BOTTOM=
# VITE_AD_SCRIPT_SRC=
# VITE_AD_CONTAINER_ID=
# VITE_SPONSOR_TITLE=
# VITE_SPONSOR_DESC=
# VITE_SPONSOR_URL=
# VITE_SPONSOR_CTA=
# VITE_SUPPORT_URL=
